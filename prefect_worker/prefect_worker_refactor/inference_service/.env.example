# Environment for the inference service. Copy to inference_service/.env.
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=<secure password>

# "name:key" pairs, same scheme as the Job API
INFERENCE_API_KEYS=annotation-app:<random-key>
INFERENCE_ALLOW_ANONYMOUS=false

# Models kept in memory at once (LRU) and max decoded input size
INFERENCE_MAX_CACHED_MODELS=2
INFERENCE_MAX_INPUT_BYTES=67108864
