# Environment for the Job API (FastAPI). Copy to job_api/.env and fill in.

# Prefect server the child workers are attached to
PREFECT_API_URL=http://localhost:4200/api

# MLflow (metadata lookups only)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=<secure password>

# Client API keys, "name:key" pairs. The name is recorded as tag mlex-client:<name>.
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JOB_API_KEYS=annotation-app:<random-key>,segmentation-app:<random-key>
# Local development only - never in production
JOB_API_ALLOW_ANONYMOUS=false

# Optional: config path (default job_api/config.yml)
# JOB_API_CONFIG=/path/to/config.yml

# Expanded inside config.yml (paths on the docker worker host)
TILED_STORAGE_DIR=/path/to/tiled_storage
CONTAINER_NETWORK=mle_net
