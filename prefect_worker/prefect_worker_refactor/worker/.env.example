# Environment for the Prefect child workers (run from this worker/ folder).
# Copy to .env and fill in. Never commit .env.

# Prefect
# =======
PREFECT_API_URL=http://localhost:4200/api
PREFECT_WORK_POOL_CONCURRENCY=4
PREFECT_WORKER_LIMIT=4
# Working directory the flows are imported from (this folder)
PREFECT_WORK_DIR=$PWD

# Conda worker
# ============
CONDA_PATH=/opt/miniconda3
# Each algorithm checked out in its own subfolder, e.g. $ALGORITHMS_DIR/mlex_dlsia_segmentation_prototype
ALGORITHMS_DIR=

# Credentials injected into job params by the child flows (never sent by clients)
# ==============================================================================
MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=<secure password>
DATA_TILED_API_KEY=
MASK_TILED_API_KEY=
SEG_TILED_API_KEY=
RESULTS_TILED_API_KEY=

# NERSC (sfapi worker) - fill ONE group, matching sfapi.login_method in ../job_api/config.yml
# =========================================================================================
# login_method: sfapi  (Iris SFAPI client id + private key JWK; chmod 600)
PATH_NERSC_CLIENT_ID=/path/to/nersc_client_id.txt
PATH_NERSC_PRI_KEY=/path/to/nersc_private_key.json
# login_method: iriapi (Globus token; log in once: python flows/sfapi/globus_token.py --validate-iri)
NERSC_USERNAME=
PATH_GLOBUS_TOKEN_FILE=
